/*
 * Warm / Blue Light Filter
 *
 * Reduces blue light by simulating a warmer color temperature (approx 3000K).
 */

#version 300 es
precision highp float;

in vec2 v_texcoord;
uniform sampler2D tex;

out vec4 fragColor;

// 3000.0 is a standard warm "Night Light" setting.
// Range: 1000.0 (very red) to 40000.0 (very blue).
const float Temperature = 3000.0;

// 0.0 is off, 1.0 is full strength.
const float Strength = 0.5;

// Function to convert Kelvin to RGB
// Source: https://www.shadertoy.com/view/4sc3D7
vec3 colorTemperatureToRGB(const in float temperature) {
    mat3 m = (temperature <= 6500.0)
        ? mat3(vec3(0.0, -2902.1955373783176, -8257.7997278925690),
               vec3(0.0, 1669.5803561666639, 2575.2827530017594),
               vec3(1.0, 1.3302673723350029, 1.8993753891711275))
        : mat3(vec3(1745.0425298314172, 1216.6168361476490, -8257.7997278925690),
               vec3(-2666.3474220535695, -2173.1012343082230, 2575.2827530017594),
               vec3(0.55995389139931482, 0.70381203140554553, 1.8993753891711275));

    return mix(
        clamp(m[0] / (vec3(clamp(temperature, 1000.0, 40000.0)) + m[1]) + m[2], 0.0, 1.0),
        vec3(1.0),
        smoothstep(1000.0, 0.0, temperature)
    );
}

void main() {
    vec4 pixColor = texture(tex, v_texcoord);
    vec3 color = pixColor.rgb;

    // Calculate the warm tint color
    vec3 warmTint = colorTemperatureToRGB(Temperature);

    // OPTIONAL: Quick luminance preservation 
    // (Prevents the screen from looking too dark when colored)
    float lum = dot(color, vec3(0.2126, 0.7152, 0.0722));
    color *= mix(1.0, lum / max(lum, 1e-5), 1.0);

    // Mix the original color with the warm tint
    color = mix(color, color * warmTint, Strength);

    fragColor = vec4(color, pixColor.a);
}

// vim: ft=glsl
